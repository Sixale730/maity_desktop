# Defensive: normalize other text formats too
*.sql        text eol=lf
*.toml       text eol=lf
*.rs         text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.js         text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.sh         text eol=lf

# Windows-specific scripts keep CRLF
*.cmd        text eol=crlf
*.bat        text eol=crlf
*.ps1        text eol=crlf

# Migraciones sqlx: BYTES CONGELADOS — git no debe tocarlas JAMAS.
# sqlx::migrate! calcula sha384 sobre los bytes y lo compara contra la
# _sqlx_migrations de cada usuario. Los bytes canonicos son los que embebio
# el release que aplico cada migracion (mezcla historica: 16 CRLF + resto LF,
# pinneada en los .sha384). Cualquier conversion de line endings (checkout,
# renormalize, autocrlf) produce binarios que rompen el arranque de usuarios
# existentes ("previously applied but has been modified") — incidentes
# v0.2.38 y 2026-07-21. Esta linea va DESPUES de *.sql para ganar precedencia.
frontend/src-tauri/migrations/*.sql -text
frontend/src-tauri/migrations/*.sql.sha384 -text

# Binary files — never normalize
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.icns       binary
*.exe        binary
*.dll        binary
*.dylib      binary
*.so         binary
*.onnx       binary
*.gguf       binary
*.bin        binary
*.wav        binary
*.mp3        binary
*.mp4        binary
*.zip        binary
*.tar        binary
*.gz         binary
