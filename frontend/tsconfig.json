{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/ui/components/ui/*": ["./src/components/ui/*"],
      "@maity/shared": ["./src/shared/maity-shared.ts"],
      "@/features/omi/services/omi.service": ["./src/features/dashboard/adapters/omi.service.ts"],
      "@/features/omi/utils/feedback-scores": ["./src/features/dashboard/adapters/feedback-scores.ts"],
      "@/features/omi/components/analysis/dashboard-v1/adapter": ["./src/features/conversations/components/analysis/dashboard-v1/adapter.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "src-tauri"
  ]
}
