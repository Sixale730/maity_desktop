{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unused-vars": ["error", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_",
      "caughtErrorsIgnorePattern": "^_",
      "destructuredArrayIgnorePattern": "^_"
    }],
    "react-hooks/exhaustive-deps": "warn",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-restricted-syntax": ["error", {
      "selector": "CallExpression[callee.property.name='rpc'][callee.object.name='supabase']",
      "message": "Usa supabase.schema('public').rpc(...) — un .rpc() sin schema explicito depende del default del cliente y, si apunta al schema equivocado, devuelve 403 en silencio (issue #70). Para un RPC de maity: .schema('maity').rpc(...)."
    }]
  },
  "overrides": [
    {
      "files": [
        "src/components/ui/checkbox.tsx",
        "src/components/ui/toggle.tsx",
        "src/components/ui/toggle-group.tsx",
        "src/features/auth/pages/**/*.{ts,tsx}",
        "src/features/auth/components/onboarding/**/*.{ts,tsx}",
        "src/features/auth/components/registration/**/*.{ts,tsx}",
        "src/features/auth/hooks/**/*.{ts,tsx}",
        "src/features/billing/components/**/*.{ts,tsx}",
        "src/features/billing/utils/**/*.{ts,tsx}",
        "src/features/avatar/components/**/*.{ts,tsx}",
        "src/shared/maity-shared/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-console": "off",
        "@typescript-eslint/no-unused-vars": "off",
        "react-refresh/only-export-components": "off",
        "@next/next/no-img-element": "off"
      }
    },
    {
      // Arbol copiado zero-drift de Sixale730/maity. Sus .rpc() pelones son
      // correctos: el cliente del desktop tiene 'public' como default desde
      // #70, que es donde viven esos wrappers.
      "files": ["src/shared/maity-shared/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-syntax": "off"
      }
    }
  ]
}
