{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unused-vars": ["error", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_",
      "caughtErrorsIgnorePattern": "^_",
      "destructuredArrayIgnorePattern": "^_"
    }],
    "react-hooks/exhaustive-deps": "warn",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-restricted-syntax": ["error", {
      "selector": "CallExpression[callee.property.name='rpc'][callee.object.name='supabase']",
      "message": "Usa supabase.schema('public').rpc(...) — un .rpc() sin schema explicito depende del default del cliente y, si apunta al schema equivocado, devuelve 403 en silencio (issue #70). Para un RPC de maity: .schema('maity').rpc(...)."
    }, {
      "selector": "CallExpression[callee.property.name='invoke'][callee.object.property.name='functions']",
      "message": "No hay edge functions de Supabase para el desktop (issue #67): el token de Deepgram viene de Vercel /api/deepgram-token y el analisis de conversations-finalize. Si de verdad hace falta una, vive en el repo web con gate server-side."
    }],
    "no-restricted-imports": ["error", {
      "paths": [{
        "name": "@tauri-apps/api/event",
        "importNames": ["listen", "once"],
        "message": "Usa subscribeTauriEvent/createSubscriptionGroup de '@/lib/tauriSubscribe'. Un listen() suelto se desregistra dos veces o se filtra al desmontar antes de que resuelva, y Tauri tira 'Cannot read properties of undefined (reading handlerId)' como unhandledrejection (issue #65). `emit` sigue permitido."
      }]
    }]
  },
  "overrides": [
    {
      "files": [
        "src/components/ui/checkbox.tsx",
        "src/components/ui/toggle.tsx",
        "src/components/ui/toggle-group.tsx",
        "src/features/auth/pages/**/*.{ts,tsx}",
        "src/features/auth/components/onboarding/**/*.{ts,tsx}",
        "src/features/auth/components/registration/**/*.{ts,tsx}",
        "src/features/auth/hooks/**/*.{ts,tsx}",
        "src/features/billing/components/**/*.{ts,tsx}",
        "src/features/billing/utils/**/*.{ts,tsx}",
        "src/features/avatar/components/**/*.{ts,tsx}",
        "src/shared/maity-shared/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-console": "off",
        "@typescript-eslint/no-unused-vars": "off",
        "react-refresh/only-export-components": "off",
        "@next/next/no-img-element": "off"
      }
    },
    {
      // Arbol copiado zero-drift de Sixale730/maity. Sus .rpc() pelones son
      // correctos: el cliente del desktop tiene 'public' como default desde
      // #70, que es donde viven esos wrappers.
      "files": ["src/shared/maity-shared/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-syntax": "off"
      }
    },
    {
      // Unicos autorizados a importar `listen` directo (issue #65):
      //  - tauriSubscribe.ts ES la implementacion del helper.
      //  - recording/transcriptService son wrappers finos que DEVUELVEN la
      //    promesa del unlisten; el ciclo de vida lo maneja el llamador con
      //    createSubscriptionGroup().
      //  - errorTelemetry.ts es fire-and-forget deliberado: init idempotente
      //    sin teardown, documentado en CLAUDE.md.
      //  - audioLevelsStore.ts (issue #07) es un store singleton fuera de
      //    React: el ref-count de suscriptores sube y baja entre MUCHOS
      //    componentes hoja independientes (barras de mic/sistema en dos
      //    ventanas Tauri distintas), no un ciclo de vida 1:1 con un solo
      //    useEffect — no encaja en el modelo "monta N listeners, suelta
      //    todos juntos" de createSubscriptionGroup. Reimplementa la misma
      //    defensa anti-doble-unlisten localmente.
      //  - los tests importan `listen` para mockearlo/tiparlo.
      "files": [
        "src/lib/tauriSubscribe.ts",
        "src/lib/errorTelemetry.ts",
        "src/lib/audioLevelsStore.ts",
        "src/services/recordingService.ts",
        "src/services/transcriptService.ts",
        "src/shared/maity-shared/**/*.{ts,tsx}",
        "**/*.test.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
