<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 uap10 desktop desktop6 rescap">

  <Identity
    Name="Sixale.Maity"
    Publisher="CN=C88867C5-0981-430C-9134-4C455473D0F2"
    Version="0.2.54.0" />

  <Properties>
    <DisplayName>Maity</DisplayName>
    <PublisherDisplayName>Maity AI</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="Maity"
      Executable="maity-desktop.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Maity"
        Description="Asistente de reuniones con IA enfocado en privacidad"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\MedTile.png"
        Square44x44Logo="Assets\AppList.png" />
      <Extensions>
        <!-- Autostart del canal Store. TaskId="MaityStartup" DEBE coincidir con
             STARTUP_TASK_ID en src-tauri/src/startup_task.rs (Windows persiste el
             estado por TaskId — no renombrarlo). Enabled=true es válido para apps
             runFullTrust; el toggle de Settings lo administra vía WinRT StartupTask.
             El exe se lanza SIN args: el arranque minimizado se detecta con
             GetActivatedEventArgs (ActivationKind::StartupTask). -->
        <desktop:Extension Category="windows.startupTask"
                           Executable="maity-desktop.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="MaityStartup"
            Enabled="true"
            DisplayName="Maity" />
        </desktop:Extension>
        <!-- Protocolo maity:// (deep links: OAuth y verificación de email). Bajo MSIX el
             deep_link().register() en runtime queda virtualizado y NO crea la asociación
             a nivel OS — sin esta declaración la app de la Store nunca recibe el link.
             El nombre debe coincidir con el scheme de tauri.conf.json ("deep-link"). -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="maity" />
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
